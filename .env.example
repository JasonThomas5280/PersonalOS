# Postgres connection for Prisma — pooled, used by the app at runtime
DATABASE_URL="postgresql://user:password@localhost:5432/personalos"
# Direct (unpooled) connection, used by `prisma migrate`. On a plain local
# Postgres this is the same URL; on Neon/pgbouncer it must be the unpooled host,
# because the pooler breaks the advisory locks migrations depend on.
DIRECT_URL="postgresql://user:password@localhost:5432/personalos"
# Server-side only — never exposed to the client (AI Coach + Capture)
ANTHROPIC_API_KEY=""
